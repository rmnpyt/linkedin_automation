    {
      "id": "call_rust_runtime_health",
      "name": "Call Rust Runtime (GET /health)",
      "notes": "REPLACES the deliberately-failing executeCommand stub (2026-09-05 Phase 0B fix): calls the rust-runtime service's GET /health endpoint, which itself invokes clitools/health's process() function -- a real, network-reachable invocation of a deterministic Rust tool, not a local-binary path the n8n host could never reach. Requires the rust-runtime container to be deployed on the same Docker network as this n8n instance (see MCP/rust-runtime/README.md). Override the hostname via the n8n host's RUST_RUNTIME_URL environment variable; defaults to http://rust-runtime:8080 (the container name used in MCP/rust-runtime/docker-compose.example.yml). onError=continueRegularOutput so a still-pending deployment is recorded as a normal FAILED step, not a broken workflow execution.",
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.RUST_RUNTIME_URL || \"http://rust-runtime:8080\") + \"/health\" }}",
        "options": {
          "timeout": 5000
        }
      },
      "position": [1568, 300],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3
    },
    {
      "id": "check_rust_runtime_result",
      "name": "Check Rust Runtime Result",
      "notes": "Distinguishes 'reached the service and got a valid health result' from every other outcome (connection refused/timeout because the service is not yet deployed, or an unexpected response shape) -- never treats an ambiguous response as success.",
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (item && item.error) {\n  return [{\n    json: {\n      success: false,\n      error_code: 'RUST_RUNTIME_UNREACHABLE',\n      error_message: typeof item.error === 'string' ? item.error : JSON.stringify(item.error)\n    }\n  }];\n}\n\nif (item && item.ok === true && item.tool === 'health' && item.result && item.result.status === 'ok') {\n  return [{ json: { success: true } }];\n}\n\nconst expectedShape = 'ok:true, tool:health, result.status:ok';\nreturn [{\n  json: {\n    success: false,\n    error_code: 'RUST_RUNTIME_UNEXPECTED_RESPONSE',\n    error_message: 'GET /health did not return the expected (' + expectedShape + ') shape: ' + JSON.stringify(item)\n  }\n}];"
      },
      "position": [1792, 300],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "rust_runtime_reachable",
      "name": "Rust Runtime Reachable?",
      "parameters": {
        "conditions": {
