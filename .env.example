# Secret storage strategy (CONTRACT.md sec.67, AGENT-START.md sec.12.1/24).
#
# This file documents *names* only. Real values MUST NOT be committed here or anywhere
# else in the repository.
#
# n8n owns the provider credentials it already has configured internally (Apify,
# OpenRouter, OpenAI, Supabase) -- those are runtime capabilities inside n8n's own
# credential store, not files, and this project MUST NOT export them into the repo or
# into these variables.
#
# The variables below are for LOCAL, non-n8n usage only: developer scripts, local Supabase
# CLI/psql access for a human operator, and any local integration test run directly against
# the linkedin_automation development project outside of n8n. clitools/ Rust binaries do
# NOT read any of these -- by design (PLAN.md sec.5, CONTRACT.md sec.7) they are pure
# functions over stdin/stdout JSON with no network access and no secrets of their own.

# Supabase development project (linkedin_automation). Never commit the actual service-role
# key; use it only in a local, gitignored .env or your shell's own secret manager.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if a human operator runs a local script against a real provider directly
# (bypassing n8n) for controlled TEST-mode validation. Default posture is MOCK: leave
# these unset for ordinary development (AGENT-START.md sec.13-14).
APIFY_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Environment-level test-spend guard (AGENT-START.md sec.14.1). MUST default to 0/unset.
# A non-zero value here is an explicit, human-authorized decision, never invented by an
# agent.
TEST_SPEND_BUDGET_USD=0
